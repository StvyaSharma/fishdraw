{
  "name": "fishdraw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "./fishdraw.ts",
  "exports": {
    ".": "./fishdraw.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "generate": "bun cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./web/index.html --outdir dist --minify --define 'process.env.NODE_ENV=\"production\"'",
    "test:e2e": "bun --bun node_modules/@playwright/test/cli.js test",
    "check": "bun run typecheck && bun test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "dialkit": "^2.1.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
